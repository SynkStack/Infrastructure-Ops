{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infrastructure-ops/config.schema.json",
  "title": "Environment configuration",
  "description": "Schema for config/<environment>/app.yaml. Secrets are referenced by variable name only and never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "app", "deployment", "secrets"],
  "properties": {
    "environment": {
      "description": "Must match the directory the file lives in.",
      "enum": ["development", "staging", "production"]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "log_level", "debug", "base_url", "port"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,40}$"
        },
        "log_level": {
          "enum": ["debug", "info", "warning", "error"]
        },
        "debug": {
          "type": "boolean"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(:[0-9]+)?(/[^\\s]*)?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_check_path",
        "health_check_timeout_seconds",
        "require_approval",
        "keep_previous_releases"
      ],
      "properties": {
        "health_check_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/_.-]*$"
        },
        "health_check_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "require_approval": {
          "type": "boolean"
        },
        "keep_previous_releases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_env_vars"],
      "properties": {
        "required_env_vars": {
          "description": "Names of environment variables that must be supplied at deploy time. Values are never stored in the repository.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
